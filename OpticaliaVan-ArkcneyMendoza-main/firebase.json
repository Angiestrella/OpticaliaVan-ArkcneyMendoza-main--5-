{
  "hosting": {
    "site": "opticalia-vanarcken-mendoza",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/encuentra-tus-gafas",
        "destination": "/que-gafas-van-contigo/",
        "type": 301
      },
      {
        "regex": "^/producto/diseno-[1-4]/?$",
        "destination": "/catalogo/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|jpg|jpeg|png|svg|mp4|glb)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ]
  }
}
