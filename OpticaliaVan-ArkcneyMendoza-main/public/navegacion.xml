<?xml version="1.0" encoding="UTF-8"?>
<!-- Navegación del sitio: única fuente para la barra superior y el pie de página.
     Es el mismo tipo de información que los JSON de src/data/, pero en XML:
     con elementos y atributos en vez de pares clave-valor.
     Atributos de <enlace>:
       href     ruta a la que lleva (obligatorio)
       label    texto visible (obligatorio)
       menu     "si" = también aparece en la barra superior
       seccion  "si" = lleva a una parte de otra página (con #), no a una página
     Se lee en vivo con fetch + DOMParser: ver src/utils/sitemap.ts. -->
<mapaDelSitio>
  <enlace href="/" label="Inicio" menu="si" />
  <enlace href="/catalogo" label="Catálogo" menu="si" />
  <enlace href="/que-gafas-van-contigo" label="¿Qué gafas van contigo?" menu="si" />
  <enlace href="/conocenos" label="Conócenos" menu="si" />
  <enlace href="/conocenos#ubicacion" label="Ubicación" menu="si" seccion="si" />
  <enlace href="/prueba-virtual" label="Pruébatelas en vivo" />
  <enlace href="/agenda" label="Agenda tu cita" />
</mapaDelSitio>
